# ============================================================
# CRYPTONITE SWAP — Backend Environment Configuration
# ============================================================
# MAINNET is the default. To switch to DEVNET, swap the
# commented/uncommented values in each section below.
# ============================================================

# === REQUIRED ===

# --- Solana Network Toggle ---
# Controls Orca whirlpools config, @solana/kit RPC wrapper,
# Irys uploader network, and all backend/worker defaults.
# Valid values: "devnet" | "mainnet"
# Devnet:  SOLANA_NETWORK=devnet
SOLANA_NETWORK=mainnet

# --- Solana RPC ---
# Use a paid mainnet RPC provider (Helius, QuickNode, Alchemy, etc.) for reliability.
# Devnet:  SOLANA_RPC_URL=https://api.devnet.solana.com
# Mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# NOTE: ORCA_NETWORK is automatically derived from SOLANA_NETWORK.
# No need to set it manually (solanaDevnet for devnet, solanaMainnet for mainnet).

# --- Wallet / Authority ---
# [USER: replace for mainnet] Use a mainnet-funded wallet (new keypair with SOL for tx fees)
# Base58-encoded private key for the server wallet
WALLET_KEY=your_base58_private_key_here

# --- Database ---
# [USER: replace for mainnet] Use a fresh mainnet database (new Neon DB with mainnet tokens/pools)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === OPTIONAL (have defaults) ===

# Token registry PDA seed (default: token_registry)
TOKEN_REGISTRY_SEED=token_registry

# Redis URL (default: redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379

# API server port (default: 8080)
API_PORT=8080

# === NOWPayments (crypto purchase feature) ===

# Devnet:  NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_SANDBOX=false

# Production keys (used when NOWPAYMENTS_SANDBOX=false)
NOWPAYMENTS_API_KEY=your_nowpayments_production_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_production_ipn_secret

# Sandbox keys (used when NOWPAYMENTS_SANDBOX=true)
NOWPAYMENTS_SANDBOX_API_KEY=your_sandbox_api_key
NOWPAYMENTS_SANDBOX_IPN_SECRET=your_sandbox_ipn_secret

# === Squads Multisig ===

# [USER: replace for mainnet] Set your Squads vault address for treasury operations
# SQUADS_VAULT_ADDRESS=your_squads_vault_address_here

# === WalletConnect ===

# Required for wallet connection in frontend
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
