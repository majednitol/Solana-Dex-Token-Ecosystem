# ============================================================
# CRYPTONITE SWAP — Frontend Environment Configuration
# ============================================================
# MAINNET is the default. To switch to DEVNET, swap the
# commented/uncommented values in each section below.
# ============================================================

VITE_TOKEN_DECIMALS=5

# --- Solana Network Toggle ---
# Controls wallet adapter network (Devnet vs Mainnet)
# Valid values: "devnet" | "mainnet"
# Devnet:  VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_NETWORK=mainnet

# --- Solana RPC (optional override) ---
# Use a paid mainnet RPC for reliability.
# Devnet:  VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# --- NOWPayments ---
# true  = MetaMask connects to EVM testnets (Sepolia, BSC Testnet, etc.)
# false = MetaMask connects to EVM mainnets (Ethereum, BSC, Polygon, etc.)
# Devnet:  VITE_NOWPAYMENTS_SANDBOX=true
VITE_NOWPAYMENTS_SANDBOX=false

# --- MoonPay ---
# "production" or "sandbox"
# Devnet:  VITE_MOONPAY_ENV=sandbox
VITE_MOONPAY_ENV=production
# [USER: replace for mainnet] Replace with your production MoonPay API key
VITE_MOONPAY_API_KEY=your_moonpay_production_api_key

# --- WalletConnect ---
# Get from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
